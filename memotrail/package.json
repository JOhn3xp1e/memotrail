{
  "name": "memotrail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "marketing:capture": "node marketing/scripts/capture.mjs",
    "marketing:posts": "node marketing/scripts/posts.mjs",
    "marketing:all": "node marketing/scripts/all.mjs",
    "marketing:verify": "node marketing/scripts/verify.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "prebuild": "tsx --tsconfig tsconfig.app.json scripts/verify-help-assets.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:backup": "tsx --tsconfig tsconfig.app.json --test tests/backup.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test:e2e": "playwright test",
    "mimo:validate": "node scripts/validate-mimo-assets.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
